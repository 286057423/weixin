/* pages/booking/booking.wxss */

.booking-form {
  padding-bottom: 40rpx;
}

.picker-display {
  display: flex;
  align-items: center;
  line-height: 88rpx;
}

.radio-wrapper {
  display: flex;
  gap: 40rpx;
}

.radio-item {
  display: flex;
  align-items: center;
  padding: 20rpx 30rpx;
  border: 2rpx solid #e8e8e8;
  border-radius: 12rpx;
  flex: 1;
  justify-content: center;
  transition: all 0.3s;
}

.radio-item.active {
  border-color: #1a5fa8;
  background: rgba(26, 95, 168, 0.05);
}

/* 成功提示页 */
.success-wrapper {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 60rpx;
}

.success-icon {
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #52c41a, #73d13d);
  color: #fff;
  font-size: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 40rpx;
}

.success-title {
  font-size: 40rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 20rpx;
}

.success-desc {
  font-size: 28rpx;
  color: #666;
  text-align: center;
  line-height: 1.6;
}
