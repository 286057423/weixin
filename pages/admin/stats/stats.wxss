/* pages/admin/stats/stats.wxss */

.time-range-bar {
  display: flex;
  justify-content: center;
  gap: 40rpx;
  padding: 20rpx 0 30rpx;
}

.range-item {
  font-size: 28rpx;
  color: #666;
  padding: 12rpx 32rpx;
  border-radius: 32rpx;
  background: #fff;
  border: 2rpx solid #e8e8e8;
}

.range-item.active {
  background: #1a5fa8;
  color: #fff;
  border-color: #1a5fa8;
}

.stats-cards {
  display: flex;
  gap: 20rpx;
}

.stats-card {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 30rpx 20rpx;
}

.stats-number {
  font-size: 48rpx;
  font-weight: bold;
  color: #1a5fa8;
  margin-bottom: 10rpx;
}

.stats-label {
  font-size: 24rpx;
  color: #666;
}

.chart-placeholder {
  width: 100%;
  height: 400rpx;
  background: linear-gradient(135deg, #f5f5f5, #e8e8e8);
  display: flex;
  align-items: center;
  justify-content: center;
  color: #999;
  font-size: 28rpx;
  border-radius: 12rpx;
  margin-top: 20rpx;
}

.pie-placeholder {
  height: 300rpx;
}

.legend-list {
  margin-top: 30rpx;
}

.legend-item {
  display: flex;
  align-items: center;
  padding: 12rpx 0;
  font-size: 26rpx;
}

.legend-dot {
  width: 20rpx;
  height: 20rpx;
  border-radius: 4rpx;
  margin-right: 16rpx;
}

.legend-item .text-secondary {
  margin-left: auto;
}
