<!-- pages/admin/settings/settings.wxml -->
<!-- 基础设置页 -->
<view class="page-container">
  <!-- 加载中 -->
  <view wx:if="{{loading}}" class="loading-wrapper">
    <text class="text-secondary">加载中...</text>
  </view>

  <view wx:else>
    <!-- 轮播图管理 -->
    <view class="card">
      <text class="card-title">首页轮播图</text>
      <view class="banner-list">
        <view class="banner-item" wx:for="{{settings.banners}}" wx:key="index">
          <view class="banner-img-placeholder">
            <text>图片 {{index + 1}}</text>
          </view>
          <view class="banner-actions">
            <text class="action-btn delete-btn" bindtap="onDeleteImage" data-index="{{index}}">删除</text>
          </view>
        </view>
      </view>
      <button class="btn-outline btn-block mt-20" bindtap="onChooseImage" data-type="banner">
        + 添加轮播图
      </button>
    </view>

    <!-- 公司简介 -->
    <view class="card mt-30">
      <text class="card-title">公司简介</text>
      <textarea class="form-textarea" placeholder="请输入公司简介" value="{{settings.companyIntro}}" bindinput="onInputChange" data-field="companyIntro" maxlength="500" />
    </view>

    <!-- 联系电话 -->
    <view class="card mt-30">
      <text class="card-title">联系电话</text>
      <input class="form-input" placeholder="请输入联系电话" value="{{settings.phone}}" bindinput="onInputChange" data-field="phone" />
    </view>

    <!-- 微信二维码 -->
    <view class="card mt-30">
      <text class="card-title">工作微信二维码</text>
      <view class="qrcode-upload">
        <view wx:if="{{settings.qrcodeUrl}}" class="qrcode-preview">
          <view class="qrcode-img-placeholder">
            <text>二维码已上传</text>
          </view>
        </view>
        <button class="btn-outline mt-20" bindtap="onChooseImage" data-type="qrcode">
          {{settings.qrcodeUrl ? '重新上传' : '上传二维码'}}
        </button>
      </view>
    </view>

    <!-- 工作时间 -->
    <view class="card mt-30">
      <text class="card-title">工作时间</text>
      <input class="form-input" placeholder="如：周一至周六 9:00-18:00" value="{{settings.workTime}}" bindinput="onInputChange" data-field="workTime" />
    </view>

    <!-- 服务区域 -->
    <view class="card mt-30">
      <text class="card-title">服务区域</text>
      <input class="form-input" placeholder="如：全市范围上门服务" value="{{settings.serviceArea}}" bindinput="onInputChange" data-field="serviceArea" />
    </view>

    <!-- 保存按钮 -->
    <button class="btn-accent btn-block btn-lg mt-40" bindtap="onSave">保存设置</button>
  </view>
</view>
