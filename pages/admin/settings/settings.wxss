/* pages/admin/settings/settings.wxss */

.banner-list {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
  margin-top: 20rpx;
}

.banner-item {
  width: 200rpx;
}

.banner-img-placeholder {
  width: 200rpx;
  height: 120rpx;
  background: linear-gradient(135deg, #e0e0e0, #f5f5f5);
  border-radius: 8rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #999;
  font-size: 24rpx;
}

.banner-actions {
  display: flex;
  justify-content: center;
  margin-top: 10rpx;
}

.action-btn {
  font-size: 24rpx;
  padding: 8rpx 16rpx;
  border-radius: 8rpx;
}

.delete-btn {
  color: #ff4d4f;
}

.qrcode-upload {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.qrcode-preview {
  margin-bottom: 20rpx;
}

.qrcode-img-placeholder {
  width: 200rpx;
  height: 200rpx;
  background: linear-gradient(135deg, #e0e0e0, #f5f5f5);
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #999;
  font-size: 24rpx;
}
