/* pages/contact/contact.wxss */

/* ==================== 二维码区域 ==================== */
.qrcode-card {
  padding: 40rpx 30rpx;
}

.qrcode-wrapper {
  display: flex;
  justify-content: center;
  align-items: center;
  margin: 30rpx 0 20rpx;
}

.qrcode-placeholder {
  width: 360rpx;
  height: 360rpx;
  background: #f0f0f0;
  border: 2rpx dashed #d0d0d0;
  border-radius: 16rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.qrcode-icon {
  font-size: 80rpx;
  color: #cccccc;
  margin-bottom: 16rpx;
}

.qrcode-placeholder-text {
  font-size: 24rpx;
  color: #999999;
}

/* ==================== 电话卡片 ==================== */
.phone-card {
  padding: 30rpx;
}

.phone-number {
  font-size: 40rpx;
  font-weight: bold;
  color: var(--color-primary);
  letter-spacing: 2rpx;
}

.phone-btn {
  padding: 12rpx 30rpx;
  font-size: 26rpx;
  border-radius: 36rpx;
  line-height: 1.6;
  min-width: auto;
}

/* ==================== 联系图标 ==================== */
.contact-icon {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.contact-icon .icon-text {
  font-size: 36rpx;
}

.phone-icon {
  background: rgba(26, 95, 168, 0.1);
}

.time-icon {
  background: rgba(255, 107, 53, 0.1);
}

.area-icon {
  background: rgba(82, 196, 26, 0.1);
}

/* ==================== 信息卡片 ==================== */
.info-card {
  padding: 30rpx;
}

.info-card .card-title {
  font-size: 30rpx;
  margin-bottom: 8rpx;
}

.info-card .card-desc {
  font-size: 28rpx;
  line-height: 1.5;
}
