/* pages/case-detail/case-detail.wxss */

.case-swiper {
  width: 100%;
  height: 500rpx;
}

.swiper-img-placeholder {
  width: 100%;
  height: 100%;
  background: linear-gradient(135deg, #e0e0e0, #f5f5f5);
  display: flex;
  align-items: center;
  justify-content: center;
  color: #999;
  font-size: 28rpx;
}

.video-section {
  margin-top: 20rpx;
}

.video-placeholder {
  width: 100%;
  height: 400rpx;
  background: linear-gradient(135deg, #d0d0d0, #e8e8e8);
  display: flex;
  align-items: center;
  justify-content: center;
  color: #999;
  font-size: 28rpx;
  border-radius: 12rpx;
}

.compare-wrapper {
  display: flex;
  justify-content: space-between;
  margin-top: 20rpx;
}

.compare-item {
  width: 48%;
  text-align: center;
}

.compare-img {
  width: 100%;
  height: 300rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff;
  font-size: 28rpx;
  font-weight: bold;
  border-radius: 12rpx;
}

.before-placeholder {
  background: linear-gradient(135deg, #ff6b35, #ff8f66);
}

.after-placeholder {
  background: linear-gradient(135deg, #1a5fa8, #4a8fd4);
}
