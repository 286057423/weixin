/* app.wxss - 全局样式 */

/* ==================== 色彩变量 ==================== */
page {
  --color-primary: #1a5fa8;       /* 主色 - 蓝色 */
  --color-primary-light: #4a8fd4; /* 主色浅 */
  --color-primary-dark: #0d3f7a;  /* 主色深 */
  --color-accent: #ff6b35;        /* 强调色 - 橙色 */
  --color-accent-light: #ff8f66;  /* 强调色浅 */
  --color-success: #52c41a;       /* 成功色 */
  --color-warning: #faad14;       /* 警告色 */
  --color-danger: #ff4d4f;        /* 危险色 */
  --color-text: #333333;          /* 主文字色 */
  --color-text-secondary: #666666;/* 次要文字色 */
  --color-text-light: #999999;    /* 浅色文字 */
  --color-bg: #f5f5f5;            /* 背景色 */
  --color-bg-white: #ffffff;      /* 白色背景 */
  --color-border: #e8e8e8;        /* 边框色 */
  --color-divider: #f0f0f0;       /* 分割线色 */

  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto,
    'Helvetica Neue', Arial, 'PingFang SC', 'Hiragino Sans GB',
    'Microsoft YaHei', sans-serif;
  font-size: 28rpx;
  color: var(--color-text);
  background-color: var(--color-bg);
  box-sizing: border-box;
}

/* ==================== 通用容器 ==================== */
.container {
  padding: 20rpx 30rpx;
  min-height: 100vh;
  box-sizing: border-box;
}

.page-container {
  padding: 20rpx 30rpx;
  padding-bottom: 120rpx; /* 预留底部空间 */
  min-height: 100vh;
  box-sizing: border-box;
}

/* ==================== 卡片组件 ==================== */
.card {
  background: var(--color-bg-white);
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.06);
}

.card-title {
  font-size: 32rpx;
  font-weight: bold;
  color: var(--color-text);
  margin-bottom: 16rpx;
}

.card-desc {
  font-size: 26rpx;
  color: var(--color-text-secondary);
  line-height: 1.6;
}

/* ==================== 按钮样式 ==================== */
.btn-primary {
  background: var(--color-primary);
  color: #ffffff;
  border: none;
  border-radius: 12rpx;
  padding: 20rpx 40rpx;
  font-size: 30rpx;
  text-align: center;
  line-height: 1.5;
}

.btn-primary::after {
  border: none;
}

.btn-accent {
  background: var(--color-accent);
  color: #ffffff;
  border: none;
  border-radius: 12rpx;
  padding: 20rpx 40rpx;
  font-size: 30rpx;
  text-align: center;
  line-height: 1.5;
}

.btn-accent::after {
  border: none;
}

.btn-outline {
  background: transparent;
  color: var(--color-primary);
  border: 2rpx solid var(--color-primary);
  border-radius: 12rpx;
  padding: 20rpx 40rpx;
  font-size: 30rpx;
  text-align: center;
  line-height: 1.5;
}

.btn-outline::after {
  border: none;
}

.btn-block {
  display: block;
  width: 100%;
}

.btn-lg {
  padding: 28rpx 40rpx;
  font-size: 34rpx;
  border-radius: 48rpx;
}

/* ==================== 底部固定按钮 ==================== */
.bottom-fixed {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 20rpx 30rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  background: #ffffff;
  box-shadow: 0 -2rpx 12rpx rgba(0, 0, 0, 0.06);
  z-index: 100;
}

.bottom-fixed .btn-accent {
  border-radius: 48rpx;
  font-size: 34rpx;
  font-weight: bold;
  letter-spacing: 4rpx;
}

/* ==================== 表单样式 ==================== */
.form-group {
  margin-bottom: 30rpx;
}

.form-label {
  font-size: 28rpx;
  color: var(--color-text);
  margin-bottom: 12rpx;
  display: block;
}

.form-label .required {
  color: var(--color-danger);
  margin-right: 6rpx;
}

.form-input {
  width: 100%;
  height: 88rpx;
  border: 2rpx solid var(--color-border);
  border-radius: 12rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
  box-sizing: border-box;
  background: #fff;
}

.form-textarea {
  width: 100%;
  min-height: 200rpx;
  border: 2rpx solid var(--color-border);
  border-radius: 12rpx;
  padding: 20rpx 24rpx;
  font-size: 28rpx;
  box-sizing: border-box;
  background: #fff;
}

/* ==================== 标签样式 ==================== */
.tag {
  display: inline-block;
  padding: 4rpx 16rpx;
  font-size: 22rpx;
  border-radius: 6rpx;
  margin-right: 12rpx;
}

.tag-primary {
  background: rgba(26, 95, 168, 0.1);
  color: var(--color-primary);
}

.tag-accent {
  background: rgba(255, 107, 53, 0.1);
  color: var(--color-accent);
}

.tag-success {
  background: rgba(82, 196, 26, 0.1);
  color: var(--color-success);
}

.tag-warning {
  background: rgba(250, 173, 20, 0.1);
  color: var(--color-warning);
}

.tag-danger {
  background: rgba(255, 77, 79, 0.1);
  color: var(--color-danger);
}

/* ==================== 列表样式 ==================== */
.list-item {
  display: flex;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 1rpx solid var(--color-divider);
}

.list-item:last-child {
  border-bottom: none;
}

/* ==================== 筛选栏 ==================== */
.filter-bar {
  display: flex;
  overflow-x: auto;
  padding: 20rpx 0;
  white-space: nowrap;
}

.filter-item {
  display: inline-block;
  padding: 12rpx 28rpx;
  margin-right: 16rpx;
  font-size: 26rpx;
  border-radius: 32rpx;
  background: #fff;
  color: var(--color-text-secondary);
  border: 2rpx solid var(--color-border);
}

.filter-item.active {
  background: var(--color-primary);
  color: #ffffff;
  border-color: var(--color-primary);
}

/* ==================== 空状态 ==================== */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 0;
}

.empty-state .empty-icon {
  width: 200rpx;
  height: 200rpx;
  margin-bottom: 30rpx;
  opacity: 0.4;
}

.empty-state .empty-text {
  font-size: 28rpx;
  color: var(--color-text-light);
}

/* ==================== 加载状态 ==================== */
.loading-wrapper {
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 40rpx 0;
}

/* ==================== 占位文本样式 ==================== */
.placeholder-text {
  color: var(--color-text-light);
  font-size: 26rpx;
  text-align: center;
  padding: 40rpx;
}

/* ==================== 分割线 ==================== */
.divider {
  height: 1rpx;
  background: var(--color-divider);
  margin: 20rpx 0;
}

/* ==================== Flex 工具类 ==================== */
.flex {
  display: flex;
}

.flex-column {
  display: flex;
  flex-direction: column;
}

.flex-center {
  display: flex;
  align-items: center;
  justify-content: center;
}

.flex-between {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.flex-wrap {
  flex-wrap: wrap;
}

.flex-1 {
  flex: 1;
}

/* ==================== 间距工具类 ==================== */
.mt-10 { margin-top: 10rpx; }
.mt-20 { margin-top: 20rpx; }
.mt-30 { margin-top: 30rpx; }
.mt-40 { margin-top: 40rpx; }
.mb-10 { margin-bottom: 10rpx; }
.mb-20 { margin-bottom: 20rpx; }
.mb-30 { margin-bottom: 30rpx; }
.mb-40 { margin-bottom: 40rpx; }
.ml-10 { margin-left: 10rpx; }
.ml-20 { margin-left: 20rpx; }
.mr-10 { margin-right: 10rpx; }
.mr-20 { margin-right: 20rpx; }
.p-20 { padding: 20rpx; }
.p-30 { padding: 30rpx; }

/* ==================== 文字工具类 ==================== */
.text-center { text-align: center; }
.text-right { text-align: right; }
.text-bold { font-weight: bold; }
.text-primary { color: var(--color-primary); }
.text-accent { color: var(--color-accent); }
.text-success { color: var(--color-success); }
.text-danger { color: var(--color-danger); }
.text-secondary { color: var(--color-text-secondary); }
.text-light { color: var(--color-text-light); }

.text-sm { font-size: 24rpx; }
.text-md { font-size: 28rpx; }
.text-lg { font-size: 32rpx; }
.text-xl { font-size: 36rpx; }
.text-xxl { font-size: 42rpx; }

/* ==================== 安全区域 ==================== */
.safe-area-bottom {
  padding-bottom: env(safe-area-inset-bottom);
}
